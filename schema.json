{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orchestrate 皮肤格式",
  "anyOf": [
    { "$ref": "#/$defs/catalog" },
    { "$ref": "#/$defs/theme" }
  ],
  "$defs": {
    "version": { "type": "integer", "const": 1 },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
      "not": {
        "enum": [
          "mist", "paper", "precision",
          "con", "prn", "aux", "nul",
          "com0", "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9",
          "lpt0", "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"
        ]
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\s<>](?:[^<>]*[^\\s<>])?(?![\\s\\S])",
      "not": { "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]" }
    },
    "color": {
      "type": "string",
      "minLength": 7,
      "maxLength": 7,
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "catalog": {
      "type": "object",
      "required": ["schemaVersion", "themes"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "themes": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "name": { "$ref": "#/$defs/name" }
            }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "required": ["schemaVersion", "id", "name", "base"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "base": { "enum": ["light", "dark"] },
        "colors": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "background", "sidebar", "surface", "indexSurface", "header",
              "text", "muted", "border", "controlBorder", "accent", "selection", "selectionText", "hover", "focus",
              "controlSurface", "controlText", "controlHover", "controlPressed",
              "primaryBackground", "primaryBorder", "primaryText", "primaryHover", "primaryHoverBorder", "primaryPressed",
              "navHover", "progress", "scrollHandle", "scrollHandleHover",
              "success", "successBackground", "warning", "warningBackground", "danger", "dangerBackground", "dangerHoverBorder",
              "disabled", "diaryMarker", "reminderMarker", "icon", "checkFill", "checkInk", "graphSecondary", "graphTertiary"
            ]
          },
          "additionalProperties": { "$ref": "#/$defs/color" }
        },
        "sidebarImage": { "const": "sidebar.png" }
      }
    }
  }
}
